# Copy to backend/.env to override. All values below are the defaults.

# Directory holding the fine-tuned checkpoint exported from Google Colab.
# Relative paths resolve against the repository root. See model/README.md.
MODEL_PATH=model/sentiment-distilbert

# Origins allowed to call the API (JSON array) — the Next.js frontend.
CORS_ORIGINS=["http://localhost:3000"]

# Title shown in the OpenAPI docs.
APP_NAME=Sentiment Classifier API
